ARTLOCK_ENV=development
ARTLOCK_SECRET_KEY=replace-with-a-long-random-secret
# Generate with: python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
ARTLOCK_ENCRYPTION_KEY=replace-with-a-url-safe-base64-encoded-32-byte-key
DATABASE_URL=sqlite:///backend/instance/artlock.db
MAX_UPLOAD_BYTES=26214400
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=backend/instance/objects
# For AWS S3 or an S3-compatible endpoint, change STORAGE_BACKEND=s3.
S3_BUCKET=
AWS_REGION=us-east-1
# For Cloudflare R2, use region=auto and endpoint=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RATELIMIT_STORAGE_URI=memory://
